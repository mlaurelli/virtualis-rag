# ---------------------------------------------------------------------------
# Configurazione Virtualis — copiare in `.env` e valorizzare
# ---------------------------------------------------------------------------

# --- LLM (endpoint OpenAI-compatible: Kimi/Moonshot oppure locale via Ollama) ---
# Chiave API: obbligatoria. Con Kimi la chiave Moonshot; con Ollama un valore
# qualsiasi non vuoto (es. "ollama"), il server locale non la verifica.
MOONSHOT_API_KEY=
# Base URL dell'API (default: https://api.moonshot.ai/v1)
# Per Ollama locale: http://localhost:11434/v1
#KIMI_BASE_URL=https://api.moonshot.ai/v1
# Modello di generazione (default: kimi-k3; con Ollama es. qwen3.6:27b)
#KIMI_MODEL=kimi-k3
# Sforzo di reasoning, specifico Kimi (default: high; lasciare VUOTO con Ollama)
#KIMI_REASONING_EFFORT=high
# Resilienza: timeout per singola richiesta in secondi (default: 120; con modelli
# locali su hardware consumer aumentare, es. 600) e retry con backoff
# esponenziale + jitter su errori transitori (429, 5xx, timeout, rete)
#LLM_REQUEST_TIMEOUT=120
#LLM_MAX_RETRIES=4
#LLM_RETRY_BASE_SECONDS=1.0
# Richieste simultanee massime verso il modello (default: 2). Semaforo globale
# nel backend: con provider seriali come Ollama evita che job paralleli
# (chat + estrazione KG + ingest) si accumulino sul provider
#LLM_MAX_CONCURRENCY=2

# --- Dati e database ---
# Directory dati (DB SQLite, upload, Qdrant embedded)
#DATA_DIR=./data

# --- Sicurezza ---
# Segreto JWT: se assente ne viene generato uno casuale a ogni avvio (solo dev)
#JWT_SECRET=
# Durata token in minuti (default: 720)
#JWT_EXPIRE_MINUTES=720
# Credenziali admin iniziale. Di default NESSUN admin viene creato: al primo
# avvio il wizard web (pagina /setup, endpoint /api/setup) guida la creazione
# del primo amministratore. Il bootstrap automatico si attiva solo impostando
# ENTRAMBE le variabili qui sotto oppure ADMIN_AUTO_CREATE=true (legacy, con
# default admin/admin se le due variabili mancano — sconsigliato in consegna)
#ADMIN_AUTO_CREATE=false
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=admin

# --- Qdrant ---
# URL server Qdrant esterno (es. http://localhost:6333); vuoto = embedded in DATA_DIR/qdrant
#QDRANT_URL=
#QDRANT_COLLECTION=chunks

# --- Modelli locali di retrieval (fasi successive) ---
#DENSE_MODEL=intfloat/multilingual-e5-large
#SPARSE_MODEL=Qdrant/bm25
#RERANKER_MODEL=BAAI/bge-reranker-v2-m3
#RERANKER_ENABLED=true
# Preriscaldamento dei modelli all'avvio, in background (default: true):
# la prima query non paga il caricamento dei pesi. Spegnere su macchine deboli
#WARMUP_ON_START=true

# --- Agente ---
#MAX_AGENT_ITERATIONS=3
# Reranker nel ciclo agentico (default: true; spegnere su macchine deboli)
#AGENT_RERANK_ENABLED=true
# Messaggi recenti della sessione passati all'agente come contesto conversazionale
#CHAT_HISTORY_MESSAGES=6
# Budget di token del contesto di sintesi: oltre questa soglia i passaggi meno
# rilevanti sono tagliati prima della chiamata LLM (default: 10000, dimensionato
# sui modelli locali con ~16k di contesto: prompt + storia + KG + margine)
#SYNTHESIZE_MAX_CONTEXT_TOKENS=10000
# Soglie anti-allucinazione sugli score del reranker (sigmoid [0,1]; ignorate
# se il reranker non è attivo): sotto RETRIEVAL_MIN_SCORE l'agente SI ASTIENE
# invece di generare; sotto RETRIEVAL_STRONG_SCORE i passaggi passano dal
# grading di rilevanza anche sui percorsi fast/ReAct
#RETRIEVAL_MIN_SCORE=0.15
#RETRIEVAL_STRONG_SCORE=0.60

# --- Architettura agentica v2 (multi-agente) ---
# Modalità del percorso agentic: "react" (default) = research agent ReAct con
# tool-calling (function calling OpenAI) al posto del ciclo retrieve/evaluate;
# "graph" = grafo a stati fissi classico. Con react, il grafo classico resta
# come fallback automatico se il tool-calling fallisce.
#AGENT_MODE=react
# Round massimi del loop ReAct (default: 6)
#REACT_MAX_ROUNDS=6
# HyDE (default: true): prima di ogni ricerca il modello scrive un passaggio
# ipotetico di risposta; le due ricerche (quesito + passaggio) sono fuse per
# score massimo — riduce il mismatch lessicale domanda/documenti
#HYDE_ENABLED=true
# CRAG (default: true): il nodo evaluate classifica ogni passaggio come
# rilevante/parziale/irrilevante; gli irrilevanti sono scartati, i parziali
# tenuti con peso minore
#CRAG_ENABLED=true
# Critic avversariale (default: true): dopo la verifica di aderenza, un secondo
# prompt tenta di confutare la risposta; il verdict diventa `confidence`
# (alta/media/bassa) nell'evento SSE `answer` e nel badge del frontend
#CRITIC_ENABLED=true
# Reflexion (default: true; richiede la critic): se il verdict è "fragile", la
# risposta è rigenerata una sola volta usando le criticità come feedback, poi
# riverificata (nodo refine; evento SSE `reset` prima dei nuovi token)
#REFLEXION_ENABLED=true
# Concorrenza massima delle ricerche del nodo retrieve (default: 3): le
# interrogazioni pianificate corrono in parallelo, ciascuna con sessione DB
# propria; fusione deterministica dei risultati
#RETRIEVE_MAX_CONCURRENCY=3
# Anti brute-force sul login (default: 5 fallimenti in 300 secondi per coppia
# IP+username, oltre → 429 con Retry-After; un login riuscito azzera il conteggio)
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_WINDOW_SECONDS=300

# --- Knowledge graph (GraphRAG) ---
# Estrazione di entità/relazioni dai documenti (default: false — usa il LLM,
# UNA chiamata per documento; popolabile dopo con scripts/kg_build.py)
#KG_ENABLED=false
# Budget di testo per documento inviato all'estrattore (default: 12000)
#KG_MAX_CHARS_PER_DOC=12000
# Numero massimo di entità estratte per documento (default: 40)
#KG_MAX_ENTITIES_PER_DOC=40
# Uso attivo del grafo nel ciclo agentico (nodo kg_lookup, percorso agentic):
# profondità di espansione delle relazioni (default: 1)
#KG_AGENT_DEPTH=1
# Documenti extra collegati via grafo ammessi nelle ricerche (default: 3)
#KG_AGENT_MAX_EXTRA_DOCS=3

# --- Frontend (produzione) ---
# Path del build React servito come SPA (default: ../frontend/dist, relativo a backend/)
#FRONTEND_DIST=../frontend/dist

# --- Ingestion (fasi successive) ---
#UPLOAD_DIR=./data/uploads
#CHUNK_TARGET_TOKENS=512
#CHUNK_OVERLAP_TOKENS=64
#OCR_ENABLED=false
# (richiede il binario tesseract con lingue ita+eng; già incluso nell'immagine Docker)
# Conversione in sottoprocesso isolato (default: true): la conversione Docling
# gira in un processo figlio persistente con limite di memoria proprio; un
# documento patologico (planimetria raster, PDF enorme) fallisce da solo con
# errore chiaro invece di far uccidere l'app dall'OOM killer del container
#CONVERT_IN_SUBPROCESS=true
# Limite di memoria (MB, RLIMIT_AS) del processo di conversione (default: 6144)
#CONVERT_MAX_MEMORY_MB=6144

# --- HTTP ---
# Origini CORS ammesse, separate da virgola
#CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- TLS (HTTPS su LAN) ---
# Entrambi valorizzati = HTTPS (avvio con `uv run python -m app` o Docker Compose);
# certificato self-signed generabile con `cd backend && uv run python scripts/gen_cert.py`
#TLS_CERT_FILE=
#TLS_KEY_FILE=
